[
  {
    "type": "effect_on_condition",
    "//": "intermediary EOC, mainly for applying blindness before transit",
    "id": "EOC_REVERBERATION_ENTER",
    "effect": [
      { "u_add_effect": "blind", "duration": 2 },
      {
        "if": { "or": [ { "u_at_om_location": "radio_tower_top" }, { "u_at_om_location": "wasp_tower_top" } ] },
        "then": { "run_eocs": "EOC_PORTAL_RADIOSPHERE", "time_in_future": 1 }
      },
      {
        "if": { "or": [ { "u_at_om_location": "cabin_roof_3" }, { "u_at_om_location": "cabin_roof_3_reverberation_hint" } ] },
        "then": { "run_eocs": "EOC_PORTAL_CABINS", "time_in_future": 1 }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_REVERBERATION_EXIT",
    "effect": [
      { "u_add_effect": "blind", "duration": 2 },
      {
        "if": { "current_dimension": "radiosphere" },
        "then": { "run_eocs": "EOC_PORTAL_RADIOSPHERE_RETURN", "time_in_future": 1 }
      },
      {
        "if": { "current_dimension": "cabins" },
        "then": { "run_eocs": "EOC_PORTAL_CABINS_RETURN", "time_in_future": 1 }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_RADIOSPHERE_DIMENSION_TRANSIT_HANDLER",
    "eoc_type": "EVENT",
    "required_event": "dimension_travel",
    "effect": [
      {
        "if": { "compare_string": [ { "context_val": "to_dimension" }, "radiosphere" ] },
        "then": [
          { "custom_light_level": 10, "length": "infinite", "key": "radiosphere_lights_off" },
          { "u_message": "Darkness envelops you.", "popup": true, "popup_w_interrupt_query": true }
        ]
      },
      {
        "if": { "compare_string": [ { "context_val": "from_dimension" }, "radiosphere" ] },
        "then": [ { "alter_timed_events": "radiosphere_lights_off" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_CABINS_DIMENSION_TRANSIT_HANDLER",
    "eoc_type": "EVENT",
    "required_event": "dimension_travel",
    "effect": [
      {
        "if": { "compare_string": [ { "context_val": "to_dimension" }, "cabins" ] },
        "then": [
          { "u_message": "Your surroundings change.", "popup": true, "popup_w_interrupt_query": true },
          { "run_eocs": [ "EOC_CABIN_DAY_CYCLE_OR_KILL_CYCLE" ] }
        ]
      },
      {
        "if": { "compare_string": [ { "context_val": "from_dimension" }, "cabins" ] },
        "then": [
          { "alter_timed_events": "cabin_daylight_cycle" },
          { "u_message": "You're back.", "popup": true, "popup_w_interrupt_query": true }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_RADIOSPHERE",
    "condition": { "and": [ { "test_eoc": "EOC_PORTAL_STORM_CONDITION_FLAG_PORTAL_PROOF" }, { "not": "u_driving" } ] },
    "effect": [
      {
        "u_travel_to_dimension": "radiosphere",
        "npc_travel_radius": 0,
        "region_type": "radiosphere",
        "npc_travel_filter": "none",
        "fail_message": "You experience brief vertigo, but nothing dangerous seems to happen.",
        "success_message": "Your surroundings warp and fold before reforming into a dark industrial area."
      },
      { "u_location_variable": { "global_val": "radiosphere_return_location" }, "z_override": true, "z_adjust": 0 },
      {
        "u_location_variable": { "context_val": "nearest_floor" },
        "terrain": "t_grate",
        "target_max_radius": 24,
        "min_radius": 0,
        "max_radius": 0
      },
      { "u_teleport": { "context_val": "nearest_floor" }, "fail_message": "", "success_message": "" },
      { "run_eocs": "EOC_REVERBERATION_EXIT", "time_in_future": [ "20 minutes", "2 hours" ] },
      { "math": [ "u_ire -= 5" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_RADIOSPHERE_RETURN",
    "condition": {
      "and": [
        { "test_eoc": "EOC_PORTAL_STORM_CONDITION_FLAG_PORTAL_PROOF" },
        { "not": "u_driving" },
        { "current_dimension": "radiosphere" }
      ]
    },
    "effect": [
      {
        "u_travel_to_dimension": "",
        "npc_travel_radius": 0,
        "npc_travel_filter": "none",
        "fail_message": "Nothing seems to change.",
        "success_message": "Your surroundings warp and fold into the recesses of the world you know."
      },
      { "u_teleport": { "global_val": "radiosphere_return_location" }, "fail_message": "", "success_message": "" },
      { "u_location_variable": { "context_val": "ground" }, "passable_only": true, "min_radius": 0, "max_radius": 10 },
      { "u_teleport": { "context_val": "ground" }, "fail_message": "", "success_message": "" },
      { "clear_dimension": "radiosphere" },
      { "u_message": "You're back.", "popup": true, "popup_w_interrupt_query": true }
    ],
    "false_effect": [
      {
        "if": { "current_dimension": "radiosphere" },
        "then": [
          {
            "u_message": "You feel a slight push in a direction you can't name, but soon it ceases.  You have a feeling it'll happen again later."
          },
          { "run_eocs": "EOC_PORTAL_RADIOSPHERE_RETURN", "time_in_future": [ "20 minutes", "2 hours" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_CABINS",
    "condition": { "and": [ { "test_eoc": "EOC_PORTAL_STORM_CONDITION_FLAG_PORTAL_PROOF" }, { "not": "u_driving" } ] },
    "effect": [
      { "u_location_variable": { "global_val": "reverberation_cabin_roof" } },
      { "u_location_variable": { "global_val": "reverberation_cabin" }, "z_adjust": -1 },
      { "u_location_variable": { "global_val": "reverberation_cabin_underground" }, "z_adjust": -2 },
      { "revert_location": { "global_val": "reverberation_cabin_roof" }, "time_in_future": 0 },
      { "revert_location": { "global_val": "reverberation_cabin" }, "time_in_future": 0 },
      { "revert_location": { "global_val": "reverberation_cabin_underground" }, "time_in_future": 0 },
      {
        "u_travel_to_dimension": "cabins",
        "npc_travel_radius": 0,
        "region_type": "cabins",
        "npc_travel_filter": "none"
      },
      { "u_location_variable": { "global_val": "cabins_return_location" }, "z_override": true, "z_adjust": 0 },
      { "run_eocs": "EOC_REVERBERATION_EXIT", "time_in_future": [ "6 hours", "12 hours" ] },
      { "math": [ "u_ire -= 5" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_CABINS_RETURN",
    "condition": {
      "and": [
        { "test_eoc": "EOC_PORTAL_STORM_CONDITION_FLAG_PORTAL_PROOF" },
        { "not": "u_driving" },
        { "current_dimension": "cabins" }
      ]
    },
    "effect": [
      { "revert_location": { "global_val": "reverberation_cabin_roof" }, "time_in_future": 0 },
      { "revert_location": { "global_val": "reverberation_cabin" }, "time_in_future": 0 },
      { "revert_location": { "global_val": "reverberation_cabin_underground" }, "time_in_future": 0 },
      {
        "u_travel_to_dimension": "",
        "npc_travel_radius": 0,
        "npc_travel_filter": "none",
        "fail_message": "Nothing seems to change.",
        "success_message": "Your surroundings warp and fold into the recesses of the world you know."
      },
      { "u_teleport": { "global_val": "cabins_return_location" } },
      { "u_location_variable": { "context_val": "ground" }, "passable_only": true, "min_radius": 0, "max_radius": 10 },
      { "u_teleport": { "context_val": "ground" }, "fail_message": "", "success_message": "" },
      { "clear_dimension": "cabins" }
    ],
    "false_effect": [
      {
        "if": { "current_dimension": "cabins" },
        "then": [
          {
            "u_message": "You feel a slight push in a direction you can't name, but soon it ceases.  You have a feeling it'll happen again later."
          },
          { "run_eocs": "EOC_PORTAL_CABINS_RETURN", "time_in_future": [ "6 hours", "12 hours" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_CABIN_DAY_CYCLE_OR_KILL_CYCLE",
    "//": "hacky way of a shorter day cycle.",
    "global": true,
    "condition": { "current_dimension": "cabins" },
    "effect": [
      { "math": [ "_cabin_light_amount = clamp( 160*sin(time('now')/3600),0,125)" ] },
      { "alter_timed_events": "cabin_daylight_cycle" },
      {
        "custom_light_level": { "context_val": "cabin_light_amount" },
        "length": "6 minutes",
        "key": "cabin_daylight_cycle"
      },
      { "run_eocs": [ "EOC_CABIN_DAY_CYCLE_OR_KILL_CYCLE" ], "time_in_future": "5 minutes" }
    ],
    "false_effect": [ { "alter_timed_events": "cabin_daylight_cycle" } ]
  }
]
